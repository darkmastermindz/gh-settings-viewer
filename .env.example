# gh-settings-viewer configuration through environment variables.
# Order of precedence: CLI flags, then these variables, then config.json (written by `npx gh-settings-viewer init`).
# Never commit a real private key.

# The GitHub App's ID (Settings → Developer settings → GitHub Apps → your app).
GITHUB_APP_ID=123456

# The app's client ID. Recommended: GitHub prefers it as the JWT issuer.
GITHUB_APP_CLIENT_ID=Iv23liExample

# The private key: a path to the .pem file (keep it chmod 600)...
GITHUB_APP_PRIVATE_KEY_PATH=/path/to/your-app.private-key.pem
# ...or the PEM text itself (takes precedence over the path). Newlines may be written as \n.
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Optional: your enterprise slug (github.com/enterprises/<slug>).
# GITHUB_ENTERPRISE_SLUG=octo-corp

# Optional: API base URL. Default https://api.github.com
#   GitHub Enterprise Server: https://github.example.com/api/v3
#   GHE.com (data residency): https://api.SUBDOMAIN.ghe.com
# GITHUB_API_URL=https://api.github.com

# Optional: turn off the daily "update available" check.
# NO_UPDATE_NOTIFIER=1
